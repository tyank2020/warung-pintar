# Frontend (Vite)
# Supabase CLI v3 menampilkan publishable key; nilai sb_publishable_... boleh dipakai di sini.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Supabase Edge Functions (server-side only, jangan pakai prefix VITE_)
# AI_BASE_URL + AI_MODEL dipakai fungsi teks (parse-voice, advisor, seasonal-advisor).
# scan-receipt memakai VLM native (Gemini generateContent); model default gemini-3.5-flash-lite.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
# Opsional: override endpoint VLM native (default https://generativelanguage.googleapis.com/v1beta)
# AI_VLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
